# MalwareBazaar API Key (Optional for some endpoints, but recommended for sample downloading)
# Obtain your free API key at: https://bazaar.abuse.ch/api/
MALWAREBAZAAR_API_KEY=

# VirusTotal Free API Key (Required for hash enrichment)
# Obtain at: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# Webhook Alert URL (Optional: Discord or Slack webhook URL to receive notifications on hits)
ALERT_WEBHOOK_URL=
